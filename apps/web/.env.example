VITE_USE_HTTPS=false
VITE_API_BASE_URL=https://grav-it-dev.inuappcenter.kr
VITE_ENABLE_API_MOCKING=false
# true면 dev 서버가 /api 요청을 VITE_API_BASE_URL로 프록시한다 (WebView·다른 기기에서 접속할 때 CORS 회피). 빌드에서는 무시된다.
VITE_API_PROXY=false
# OAuth 리다이렉트 목적지. 서버가 이 값으로 등록된 redirect_uri를 고른다.
# local(개발 서버) · dev(develop 배포) · prod(main 배포) 중 하나.
# 배포 환경 값은 플랫폼 환경변수로 주입한다.
VITE_OAUTH_DEST=local
