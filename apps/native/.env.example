# Use the current HTTPS tunnel URL when the device cannot reach the local Vite server.
EXPO_PUBLIC_WEB_URL=https://your-domain.ngrok-free.app

# 아래 로그인 값이 없으면 개발 빌드는 경고 후 해당 SDK 설정만 빼고, production 빌드는 실패한다.

# Kakao Developers > 앱 키 > 네이티브 앱 키.
KAKAO_NATIVE_APP_KEY=

# Google Cloud > 사용자 인증 정보. 웹 클라이언트 ID 는 서버가 idToken 의 aud 로 검증하는 값이다.
GOOGLE_IOS_CLIENT_ID=
GOOGLE_WEB_CLIENT_ID=

# 네이버 개발자센터 > 애플리케이션. URL scheme 은 iOS 설정에 등록한 값이다.
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
NAVER_URL_SCHEME=
